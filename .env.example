# ─── What to watch ───────────────────────────────────────────────────────────
# Ticker as Yahoo Finance knows it (AAPL, TQQQ, BTC-USD, ASML.AS, 7203.T, …)
SYMBOL=TQQQ

# Alert when the price is this many percent below the window's highest high.
DROP_THRESHOLD_PERCENT=25

# How far back the "highest high" window reaches, in months.
LOOKBACK_MONTHS=6

# ─── Telegram ────────────────────────────────────────────────────────────────
# Any URL that delivers a message. Two supported shapes:
#
#   1. Put {message} where the text goes (it is URL-encoded for you):
#      TELEGRAM_URL=https://api.telegram.org/bot123456:AA-token/sendMessage?chat_id=987654&text={message}
#
#   2. Leave it out, and the text is appended as TELEGRAM_MESSAGE_PARAM:
#      TELEGRAM_URL=https://api.telegram.org/bot123456:AA-token/sendMessage?chat_id=987654
#
# Works just as well with CallMeBot, IFTTT, n8n, Make, or your own webhook.
TELEGRAM_URL=

# GET (default) or POST. POST also sends {"text": "..."} as a JSON body.
TELEGRAM_METHOD=GET
# Query parameter carrying the message when {message} is not used.
TELEGRAM_MESSAGE_PARAM=text
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_RETRIES=3

# ─── Alert throttling (optional) ─────────────────────────────────────────────
# Each run is its own container, so throttling needs somewhere durable to
# remember the last alert. Without STATE_FILE on a volume, every run that finds
# the symbol below the threshold sends a message — fine for a daily schedule,
# noisy for an hourly one.
# STATE_FILE=/data/alert-state.json
ALERT_COOLDOWN_HOURS=24

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Evaluate and log, but never actually call the Telegram URL.
DRY_RUN=false
LOG_LEVEL=info
# Human-readable logs for local dev (needs devDependencies installed).
LOG_PRETTY=false

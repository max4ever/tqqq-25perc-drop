# ─── Telegram (required) ─────────────────────────────────────────────────────
# From @BotFather — the whole thing, including the part before the colon.
TELEGRAM_BOT_TOKEN=123456789:AAExample-Token

# Who to message. Negative for groups, @name for channels.
TELEGRAM_CHAT_ID=987654321

# ─── What to watch (optional) ────────────────────────────────────────────────
# Shown with their defaults. Leave them out entirely and you get exactly this:
# has TQQQ dropped 25% from its six-month high?

# Ticker as Yahoo Finance knows it (AAPL, TQQQ, BTC-USD, ASML.AS, 7203.T, …)
# SYMBOL=TQQQ

# Alert when the price is this many percent below the window's highest high.
# DROP_THRESHOLD_PERCENT=25

# How far back the "highest high" window reaches, in months.
# LOOKBACK_MONTHS=6

# ─── Testing ─────────────────────────────────────────────────────────────────
# Send the message even when the threshold was not reached, so you can confirm
# the bot reaches you. The message says plainly that it is a test. Turn it back
# off afterwards, or you get one every single run.
# FORCE_NOTIFY=true

# ─── What to watch ───────────────────────────────────────────────────────────
# Ticker as Yahoo Finance knows it (AAPL, TQQQ, BTC-USD, ASML.AS, 7203.T, …)
SYMBOL=TQQQ

# Alert when the price is this many percent below the window's highest high.
DROP_THRESHOLD_PERCENT=25

# How far back the "highest high" window reaches, in months.
LOOKBACK_MONTHS=6

# ─── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather — the whole thing, including the part before the colon.
TELEGRAM_BOT_TOKEN=123456789:AAExample-Token

# Who to message. Negative for groups, @name for channels.
TELEGRAM_CHAT_ID=987654321
